{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",

    "strict": true,
    "declaration": true,

    "paths": {
      "@ui/*": ["./packages/*"]
    },

    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["packages/**/*"]
}
